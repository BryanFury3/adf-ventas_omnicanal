{
	"name": "df_productos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "productos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "productos_sql",
						"type": "DatasetReference"
					},
					"name": "destino"
				}
			],
			"transformations": [
				{
					"name": "limpieza"
				},
				{
					"name": "validacion"
				},
				{
					"name": "conversion"
				}
			],
			"scriptLines": [
				"source(output(",
				"          producto_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          marca as string,",
				"          precio_lista as string,",
				"          costo_unitario as string,",
				"          proveedor as string,",
				"          estado_producto as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(categoria = initCap(lower(trim(categoria))),",
				"          precio_texto = replace(replace(trim(precio_lista), 'Bs ', ''), ',', '.')) ~> limpieza",
				"limpieza split(!isNull(producto_id) && !isNull(precio_lista) && !isNull(costo_unitario),",
				"     disjoint: false) ~> validacion@(validos, rechazados)",
				"validacion@validos derive(precio_texto = toDecimal(precio_texto),",
				"          costo_unitario = toDecimal(costo_unitario)) ~> conversion",
				"conversion sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          producto_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          marca as string,",
				"          precio_lista as decimal(12,2),",
				"          costo_unitario as decimal(12,2),",
				"          proveedor as string,",
				"          estado_producto as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          producto_id,",
				"          nombre_producto,",
				"          categoria,",
				"          marca,",
				"          precio_lista = precio_texto,",
				"          costo_unitario,",
				"          proveedor,",
				"          estado_producto",
				"     )) ~> destino"
			]
		}
	}
}